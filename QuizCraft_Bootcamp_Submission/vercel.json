
{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "vercel_app": {
      "root": "QuizCraft_Bootcamp_Submission/vercel_app",
      "framework": "fastapi"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {
        "service": "vercel_app"
      }
    }
  ]
}
